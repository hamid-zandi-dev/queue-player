{
  "manifest_version": 3,
  "name": "Queue Player",
  "version": "0.1.0",
  "description": "Play every audio or video track found on a page back to back, as a queue.",
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Queue Player",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["panel-styles.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
